{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git stash list:*)",
      "Bash(git remote -v)",
      "Bash(make help)",
      "Bash(make test-py:*)",
      "Bash(make lint:*)",
      "Bash(make fix-lint:*)",
      "Bash(make lint-py:*)",
      "Bash(make fix-lint-py:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh api repos/City-Bureau/documenters/*)",
      "Bash(python manage.py shell:*)",
      "Bash(python manage.py showmigrations:*)",
      "Bash(python manage.py check:*)",
      "Bash(python manage.py validate_templates:*)"
    ],
    "deny": [
      "Bash(git push --force origin development:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push --force-with-lease origin development:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(git push -f origin development:*)",
      "Bash(git push -f origin main:*)"
    ],
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format_py_after_edit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block_direct_lint_tools.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_start_context.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
